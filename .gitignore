# Git에 올리지 않을 파일 (.gitignore)
# 다시 만들 수 있는 파일(설치·빌드·테스트 결과)과 비밀 값은 올리지 않아요.
#
# 형식: 한 줄에 파일·폴더 이름 모양 하나. *는 "아무 글자나", 맨 앞의 !는 "앞 규칙의 예외(이것은 올려요)"라는 뜻이에요.
#   이미 Git에 올라간 파일은 여기에 적어도 계속 추적돼요. 새로 생기는 파일에만 효과가 있어요.

# 설치한 라이브러리 (pnpm install로 다시 받을 수 있어요)
node_modules

# 빌드 결과 (pnpm build로 다시 만들 수 있어요)
.next
*.tsbuildinfo
# next-env.d.ts: Next.js가 개발 서버·빌드 때 알아서 만드는 타입 선언 파일
next-env.d.ts

# Cloudflare Workers용 빌드 결과와 로컬 실행 기록 (pnpm cf:preview로 다시 만들 수 있어요)
.open-next
.wrangler

# 테스트 결과 (coverage: 단위 테스트 범위 보고서, test-results·playwright-report: E2E 기록)
coverage
test-results
playwright-report

# 비밀 값이 들어갈 수 있는 환경 변수 파일 (.env, .env.local 등). 예시 파일(.env.example)만 올려요.
.env*
!.env.example
# wrangler의 로컬 비밀 값 파일. 이 블로그는 .env.local을 쓰지만, 혹시 만들어도 올라가지 않게 막아 둬요.
.dev.vars*

# macOS가 폴더마다 만드는 파일
.DS_Store
